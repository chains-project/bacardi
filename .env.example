BENCHMARK_PATH=
JAVA_VERSION_INCOMPATIBILITY_FILE=
APIDIFF_FILE=
PYTHON_SCRIPT=
PROJECTS_PATH=
PIPELINE=
OUTPUT_PATH=
RESTART=
MAX_ATTEMPT=
SPECIFIC_FILE=

# Apptainer sandbox cache (optional, defaults to <PROJECTS_PATH>/.apptainer-sandboxes)
APPTAINER_SANDBOX_DIR=

# LLM selection: which model to use and how to reach it.
# LLM_TYPE picks the provider; LLM is the model name/id for that provider.
LLM_TYPE=
LLM=
MAX_TOKEN=
LLM_TEMP=
TIMEOUT=

# --- Cloud providers (require an API key) ---
# LLM_TYPE=openai
API_KEY=
API_KEY_ORGANIZATION=
# LLM_TYPE=anthropic
ANTHROPIC_API_KEY=
# LLM_TYPE=google
GOOGLE_API_KEY=
# LLM_TYPE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER=

# --- Local model via Unsloth (no API key needed) ---
# LLM_TYPE=local
# LLM=<the model id/path you started llm/local_server/serve_unsloth.py with>
# Start the server first: python3 llm/local_server/serve_unsloth.py --model <unsloth-model-id> --port 8001
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
